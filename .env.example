# ---- Backend (copy to backend/.env) ----
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/certificates for local dev, see `npm run dev:db`)
DATABASE_URL=
# Public URL of the API (used by mobile app / server-side links)
API_URL=http://localhost:4000
# Public URL of the participant web app; QR codes and verification links are built from this.
# MUST be your real https domain in production, e.g. https://certs.yourdomain.com
APP_URL=http://localhost:3000
# Comma separated browser origins allowed to call the API directly (the web/admin apps proxy /api, so usually empty)
CORS_ORIGINS=
# Set true when running behind a reverse proxy / load balancer (correct client IPs for rate limiting)
TRUST_PROXY=false
# At least 32 random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Defaults to true in production; set false only for plain-http local testing of production builds
COOKIE_SECURE=

# Used by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Storage: local (dev) or s3 (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: use an installed Chrome/Chromium instead of the one Puppeteer downloads
PUPPETEER_EXECUTABLE_PATH=
# Set true in Docker / as root on Linux
PUPPETEER_NO_SANDBOX=false

# ---- web / admin (copy to web/.env.local and admin/.env.local) ----
# Where the Next.js servers proxy /api/* to
# API_URL=http://localhost:4000

# ---- mobile (mobile/.env) ----
# EXPO_PUBLIC_API_URL=https://your-api-domain
# EXPO_PUBLIC_APP_URL=https://certs.yourdomain.com
